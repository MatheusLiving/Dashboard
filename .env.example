# ---------------------------------------------------------------------------
# Configuração da aplicação — copie este ficheiro para .env e ajuste os valores
# ---------------------------------------------------------------------------

# Ambiente: development | production
APP_ENV=development
# Mostrar erros detalhados no ecrã (apenas em desenvolvimento)
APP_DEBUG=true
# Nome apresentado na interface
APP_NAME="Departamento de TI"
# URL base da aplicação (sem barra final)
APP_URL=http://localhost:8080
# Fuso horário usado em todos os cálculos de datas e semanas ISO
APP_TIMEZONE=Europe/Lisbon

# ---------------------------------------------------------------------------
# Base de dados MySQL 8.0
# ---------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=relatorio_ti
DB_USERNAME=relatorio
DB_PASSWORD=relatorio
DB_CHARSET=utf8mb4

# Palavra-passe do utilizador root do MySQL (usada apenas pelo docker-compose)
DB_ROOT_PASSWORD=root

# ---------------------------------------------------------------------------
# Sessões
# ---------------------------------------------------------------------------
# Nome do cookie de sessão
SESSION_NAME=relatorio_ti_sessao
# Tempo de inatividade até expirar a sessão, em minutos
SESSION_LIFETIME=120
# Enviar o cookie apenas em HTTPS (colocar a true em produção)
SESSION_SECURE=false

# ---------------------------------------------------------------------------
# Envio de correio (SMTP)
# ---------------------------------------------------------------------------
# Servidor SMTP. Com o docker-compose, o Mailpit responde em "mailpit".
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
# Deixe em branco quando o servidor não exige autenticação (é o caso do Mailpit).
MAIL_USERNAME=
MAIL_PASSWORD=
# Cifra da ligação: tls, ssl ou vazio para nenhuma.
MAIL_ENCRYPTION=
# Remetente das mensagens enviadas pela aplicação.
MAIL_FROM_ADDRESS=relatorios@ti.local
MAIL_FROM_NAME="Relatório Semanal de TI"
# Endereço para onde vão as respostas; em branco usa o do colaborador que envia.
MAIL_REPLY_TO=
# Desligue para impedir o envio (o botão desaparece da interface).
MAIL_ENABLED=true

# ---------------------------------------------------------------------------
# Relatórios
# ---------------------------------------------------------------------------
# Caminho do template .docx, relativo à raiz do projeto
REPORT_TEMPLATE=storage/templates/Relatorio_Semanal_TI_template.docx
# Pasta onde ficam os .docx gerados, relativa à raiz do projeto
REPORT_OUTPUT=storage/reports
